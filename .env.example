# Contoh konfigurasi bot downloader. Salin jadi .env lalu isi.
# JANGAN commit file .env yang sudah diisi — berisi secret.
BOT_TOKEN=isi_token_bot_telegram_di_sini
OWNER_CHAT_ID=6690512207

# MySQL (opsional). Kalau tidak diset, bot pakai SQLite lokal (cache.db)
# dengan TTL + cleanup yang sama. JANGAN isi credential di repo.
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# MySQL pakai TLS default (rejectUnauthorized). Matikan hanya untuk MySQL
# lokal tanpa TLS: MYSQL_SSL=false

# Cache: berapa hari file_id hasil download disimpan sebelum kedaluwarsa.
# CACHE_TTL_DAYS=7

# Cobalt API (opsional, jalur cadangan YouTube/Instagram). API publik cobalt
# sekarang minta JWT — tanpa key, jalur cobalt dilewati otomatis.
# COBALT_API_KEY=
